{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./out",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "paths": {
      "@Root/*": ["./*"],
      "@/*": ["./src/*"]
    },

    "module": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node", "mocha"]
  },
  "include": ["src/**/*", "scripts/**/*"]
}
