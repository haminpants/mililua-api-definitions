{
  "name": "mililua-api-definitions",
  "displayName": "MiliLua API Definitions",
  "description": "IntelliSense and documentation for the Miliastra Wonderland Lua API.",
  "version": "1.3.2",
  "publisher": "haminpants",
  "icon": "images/icon.png",
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "emmylua",
    "intellisense",
    "mililua",
    "miliastra",
    "genshin",
    "ugc",
    "lua"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/haminpants/mililua-api-definitions.git"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "extensionDependencies": [
    "sumneko.lua"
  ],
  "activationEvents": [
    "onLanguage:lua"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "MiliLua API Definitions",
      "properties": {
        "mililua.enableDefinitions": {
          "type": "boolean",
          "default": null,
          "description": "(Workspace only) Whether to enable Miliastra Wonderland Lua API support for the current workspace.",
          "scope": "resource"
        }
      }
    },
    "snippets": [
      {
        "language": "lua",
        "path": "./snippets/lua.code-snippets"
      }
    ]
  },
  "scripts": {
    "fetch-definitions": "node scripts/fetch-definitions.js",
    "vscode:prepublish": "npm run fetch-definitions && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "protobufjs": "^8.8.1"
  }
}
