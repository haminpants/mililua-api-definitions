{
  "name": "mililua-api-definitions",
  "displayName": "MiliLua API Definitions",
  "description": "IntelliSense and documentation for the Miliastra Wonderland Lua API.",
  "version": "1.3.2",
  "publisher": "haminpants",
  "icon": "images/icon.png",
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "emmylua",
    "intellisense",
    "mililua",
    "miliastra",
    "genshin",
    "ugc",
    "lua"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/haminpants/mililua-api-definitions.git"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "extensionDependencies": [
    "sumneko.lua"
  ],
  "activationEvents": [
    "workspaceContains:*.gil",
    "workspaceContains:**/*.lua"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "MiliLua API Definitions",
      "properties": {
        "mililua.enableDefinitions": {
          "type": "boolean",
          "default": null,
          "description": "(Workspace only) Whether to enable Miliastra Wonderland Lua API support for the current workspace.",
          "scope": "resource"
        },
        "mililua.enableExtractGilResources": {
          "type": "boolean",
          "default": null,
          "description": "(Workspace only) Whether to enable resource extraction from the .gil file matching the current workspace folder name.",
          "scope": "resource"
        }
      }
    },
    "snippets": [
      {
        "language": "lua",
        "path": "./snippets/lua.code-snippets"
      }
    ]
  },
  "scripts": {
    "generate-ts-protobuf": "protoc --proto_path=./res/ --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto.cmd --ts_proto_out=./generated ./res/beyond_stage.proto",
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && npm run generate-ts-protobuf && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "vscode:prepublish": "npx tsx scripts/fetch-definitions.ts && npm run package",
    "package": "npm run check-types && npm run generate-ts-protobuf && node esbuild.js --production"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.134.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "ts-proto": "^2.15.3"
  }
}
